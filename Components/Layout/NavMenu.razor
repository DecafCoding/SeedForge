@implements IDisposable

@inject NavigationManager NavigationManager

@* Top bar. The brand mark + two-tone wordmark and the toggle chrome are styled
   with the --sf-* tokens defined in wwwroot/app.css, so both themes track it. *@
<nav class="navbar navbar-expand-lg" style="background:var(--sf-surface);border-bottom:1px solid var(--sf-border);">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <span style="width:26px;height:26px;border-radius:8px;flex:0 0 26px;background:var(--sf-accent);display:inline-flex;align-items:center;justify-content:center;box-shadow:0 0 0 4px rgba(var(--sf-accent-rgb),.13);">
                <i class="bi bi-asterisk" style="font-size:12px;color:var(--sf-bg);"></i>
            </span>
            <span style="font-family:var(--sf-serif);font-size:1.35rem;font-weight:600;letter-spacing:-.01em;line-height:1;color:var(--sf-ink);">Seed<span style="color:var(--sf-muted);font-weight:400;">Forge</span></span>
        </a>

        <div class="d-flex align-items-center gap-1">
            <a class="nav-link d-inline-flex align-items-center justify-content-center" href="config" title="Config"
               style="width:36px;height:36px;border-radius:8px;">
                <i class="bi bi-sliders" style="font-size:1rem;"></i>
            </a>
            <ThemeToggle />
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
