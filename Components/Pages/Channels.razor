@page "/channels"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using SeedForge.Domain
@using SeedForge.Features.Discovery
@inject ChannelLibrary Library
@inject PollChannelsHandler PollChannels

<PageTitle>Channels</PageTitle>

<PageHeader Eyebrow="Library" Icon="bi-broadcast" Title="Channels">
    The discovery library: YouTube channels polled for new uploads. New uploads are enqueued to the
    processing queue (drained by the Processing worker on <a href="queues">Queues</a>).
    Use <em>Poll Now</em> for an on-demand poll.
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

<h2 class="h5 mb-2">Add a channel</h2>
<div class="input-group mb-4" style="max-width:40rem">
    <input class="form-control" placeholder="UC… id, /channel/ URL, or @@handle" @bind="_input" disabled="@_busy" />
    <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))" @onclick="AddChannel">
        @(_busy ? "Working…" : "Add Channel")
    </button>
</div>

<div class="d-flex align-items-center gap-2 mb-2">
    <h2 class="h5 m-0">Followed channels</h2>
    <span class="sf-mono" style="font-size:.72rem;color:var(--sf-faint);">@_channels.Count followed</span>
</div>
@if (_channels.Count == 0)
{
    <p class="text-muted">No channels yet. Add one above.</p>
}
else
{
    <div class="card mb-3"><div class="card-body p-0">
        <table class="table m-0 mx-1">
            <thead>
                <tr><th>Title</th><th>Channel id</th><th>Videos</th><th>Last polled (UTC)</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var channel in _channels)
                {
                    <tr>
                        <td>@channel.Title</td>
                        <td><span class="sf-mono" style="font-size:.82rem;">@channel.YouTubeChannelId</span></td>
                        <td>@(_videoCounts.TryGetValue(channel.Id, out var count) ? count : 0)</td>
                        <td>@channel.LastPolledUtc.ToDisplay()</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary me-2" disabled="@_busy" @onclick="() => PollNow(channel.Id)">Poll Now</button>
                            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => Remove(channel.Id)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}

<button class="btn btn-link px-0" disabled="@_busy" @onclick="RefreshAsync">Refresh</button>

@code {
    private List<Channel> _channels = new();
    private Dictionary<int, int> _videoCounts = new();
    private string _input = string.Empty;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _error = null;
        try
        {
            _channels = await Library.ListAsync();
            _videoCounts = await Library.VideoCountsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load channels: {ex.Message}";
        }
    }

    private async Task AddChannel()
    {
        await RunAsync(async () =>
        {
            var channel = await Library.AddAsync(_input);
            _message = $"Added \"{channel.Title}\".";
            _input = string.Empty;
        });
    }

    private async Task PollNow(int? channelId)
    {
        await RunAsync(async () =>
        {
            var result = await PollChannels.HandleAsync(new PollChannelsRequest(channelId), CancellationToken.None);
            var newCount = result.Channels.Sum(c => c.NewVideoCount);
            _message = $"Polled {result.Channels.Count} channel(s); enqueued {newCount} new upload(s).";
        });
    }

    private async Task Remove(int channelId)
    {
        await RunAsync(async () =>
        {
            await Library.RemoveAsync(channelId);
            _message = "Channel removed.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
