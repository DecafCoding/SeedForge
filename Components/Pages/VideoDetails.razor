@page "/videos/{Id:int}"
@rendermode InteractiveServer
@using SeedForge.Domain
@using SeedForge.Features.Browse
@using SeedForge.Features.Maintenance
@inject BrowseQueries Browse
@inject BackfillVideoMetadataHandler Backfill

<PageTitle>@(_v?.Title ?? "Video") — Details</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_busy)
{
    <p><em>Loading…</em></p>
}
else if (_v is null)
{
    <h1>Video not found</h1>
    <p>No video with id <code>@Id</code> exists. <a href="/videos">Back to videos</a>.</p>
}
else
{
    <div style="margin-bottom:1.4rem;">
        <div style="display:flex;align-items:center;gap:9px;color:var(--sf-faint);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px;">
            <i class="bi bi-camera-video"></i><span>Library</span>
            <span style="letter-spacing:normal;text-transform:none;font-weight:400;">·</span>
            <a href="/videos" style="letter-spacing:normal;font-weight:600;text-decoration:none;">← All videos</a>
        </div>
        <h1 style="font-size:2.15rem;margin:0;line-height:1.15;">@(string.IsNullOrWhiteSpace(_v.Title) ? _v.Url : _v.Title)</h1>
    </div>

    <div class="row">
        <div class="col-md-7">
            <h2 class="h5 mb-2">Identity</h2>
            <dl class="row mb-4">
                <dt class="col-sm-4">URL</dt>
                <dd class="col-sm-8"><a href="@_v.Url" target="_blank">@_v.Url</a></dd>

                <dt class="col-sm-4">Channel</dt>
                <dd class="col-sm-8">@(_v.Channel ?? "—")</dd>

                <dt class="col-sm-4">Duration</dt>
                <dd class="col-sm-8">@_v.DurationSeconds.ToYouTubeLength()</dd>

                @if (_v.ViewCount is long views)
                {
                    <dt class="col-sm-4">Views</dt>
                    <dd class="col-sm-8">@views.ToString("N0")</dd>
                }
                @if (_v.PublishedAtUtc is DateTime published)
                {
                    <dt class="col-sm-4">Published</dt>
                    <dd class="col-sm-8">@published.ToDisplay()</dd>
                }
            </dl>

            <h2 class="h5 mb-2">Lifecycle</h2>
            <dl class="row mb-4">
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@VideoStateLabel(_v.Status)</dd>

                <dt class="col-sm-4">Date added</dt>
                <dd class="col-sm-8">@_v.DateAddedUtc.ToDisplay()</dd>

                <dt class="col-sm-4">Date processed</dt>
                <dd class="col-sm-8">
                    @if (_v.DateProcessedUtc is DateTime processed)
                    {
                        <span>@processed.ToDisplay()</span>
                        @if (_v.IsProcessedDerived)
                        {
                            <span class="badge bg-secondary ms-1" title="Derived from the AI trace / transcript, not a stored timestamp">derived</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt class="col-sm-4">Attempts</dt>
                <dd class="col-sm-8">@_v.AttemptCount</dd>

                <dt class="col-sm-4">Apify cost</dt>
                <dd class="col-sm-8">@(_v.ApifyCostUsd is double cost ? cost.ToString("C4") : "—")</dd>

                @if (!string.IsNullOrWhiteSpace(_v.ErrorMessage))
                {
                    <dt class="col-sm-4">Error</dt>
                    <dd class="col-sm-8 text-danger">@_v.ErrorMessage</dd>
                }
            </dl>
        </div>

        <div class="col-md-5">
            @if (!string.IsNullOrWhiteSpace(_v.ThumbnailUrl))
            {
                <img src="@_v.ThumbnailUrl" alt="thumbnail" class="img-fluid rounded mb-3" />
            }

            <h2 class="h5 mb-2">Yield</h2>
            <dl class="row">
                <dt class="col-sm-6">Segments</dt>
                <dd class="col-sm-6">@_v.SegmentCount</dd>

                <dt class="col-sm-6">Ideas</dt>
                <dd class="col-sm-6">@_v.IdeaCount/@_v.Passed <small class="text-muted">(total / passed)</small></dd>

                <dt class="col-sm-6">Concepts</dt>
                <dd class="col-sm-6">@_v.Concepts.Count</dd>

                <dt class="col-sm-6">AI cost</dt>
                <dd class="col-sm-6">@_v.TotalCost.ToString("0.######") <small class="text-muted">(@_v.TotalTokens tok)</small></dd>
            </dl>
        </div>
    </div>

    <h2 class="h5 mb-2">Transcript</h2>
    @if (string.IsNullOrWhiteSpace(_v.TranscriptText))
    {
        <p><em>No transcript stored for this video.</em></p>
    }
    else
    {
        <details class="mb-4">
            <summary class="text-muted">
                @_v.TranscriptText.Length.ToString("N0") characters
                @if (_v.TranscriptFetchedAtUtc is DateTime fetched)
                {
                    <span> · fetched @fetched.ToDisplay()</span>
                }
                <span> — click to expand</span>
            </summary>
            <pre class="border rounded p-3 mt-2 mb-0" style="white-space: pre-wrap; max-height: 400px; overflow-y: auto;">@_v.TranscriptText</pre>
        </details>
    }

    <h2 class="h5 mb-2">Concepts</h2>
    @if (_v.Concepts.Count == 0)
    {
        <p><em>No concepts built from this video yet.</em></p>
    }
    else
    {
        <div class="card mb-4"><div class="card-body p-0">
        <table class="table table-sm table-hover align-middle m-0 mx-1">
            <thead>
                <tr><th>Title</th><th>Genre</th><th>State</th><th>Model</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var c in _v.Concepts)
                {
                    <tr>
                        <td><a href="/concepts">@c.Title</a></td>
                        <td>@c.Genre</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">active</span>
                            }
                            @if (c.IsStale)
                            {
                                <span class="badge bg-warning text-dark">stale</span>
                            }
                            @if (!c.IsActive && !c.IsStale)
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@c.Model</td>
                        <td><small class="text-muted">@c.CreatedAtUtc.ToDisplay()</small></td>
                    </tr>
                }
            </tbody>
        </table>
        </div></div>
    }

    <h2 class="h5 mb-2">AI trace</h2>
    @if (_v.AiCalls.Count == 0)
    {
        <p><em>No AI calls recorded for this video.</em></p>
    }
    else
    {
        <div class="card mb-4"><div class="card-body p-0">
        <table class="table table-sm align-middle m-0 mx-1">
            <thead>
                <tr><th>#</th><th>Stage</th><th>Slot</th><th>Model</th><th class="text-end">Tokens</th><th class="text-end">Cost</th><th>Ok</th><th>When</th></tr>
            </thead>
            <tbody>
                @foreach (var call in _v.AiCalls)
                {
                    <tr>
                        <td>@call.Id</td>
                        <td>@call.Stage</td>
                        <td>@call.Slot</td>
                        <td>@call.Model</td>
                        <td class="text-end">@call.TotalTokens</td>
                        <td class="text-end">@call.EstimatedCost.ToString("0.######")</td>
                        <td>@(call.Success ? "✓" : "✗")</td>
                        <td><small class="text-muted">@call.CreatedAtUtc.ToDisplay()</small></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Total (@_v.AiCalls.Count call@(_v.AiCalls.Count == 1 ? "" : "s"))</td>
                    <td class="text-end">@_v.TotalTokens</td>
                    <td class="text-end">@_v.TotalCost.ToString("0.######")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
        </div></div>
    }

    <button class="btn btn-outline-secondary" disabled="@_working" @onclick="BackfillMetadataAsync">
        @(_working ? "Working…" : "Backfill Video Metadata")
    </button>
    @if (_message is not null)
    {
        <div class="alert alert-success mt-2">@_message</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private VideoDetail? _v;
    private bool _busy = true;
    private bool _working;
    private string? _message;
    private string? _error;

    private async Task BackfillMetadataAsync()
    {
        _working = true;
        _message = null;
        _error = null;
        try
        {
            var result = await Backfill.HandleAsync();
            _message = $"Backfill complete: {result.Updated} of {result.Scanned} candidate video(s) updated.";
            _v = await Browse.VideoDetailAsync(Id, default); // refresh this video's metadata view
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _v = await Browse.VideoDetailAsync(Id, default);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load video: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }


    // Mirrors Videos.razor / Queues.razor — a legitimate "Processed · 0 ideas" is NOT a failure.
    private static string VideoStateLabel(VideoJobStatus status) => status switch
    {
        VideoJobStatus.Pending => "Pending",
        VideoJobStatus.InProgress => "In progress",
        VideoJobStatus.Done => "Done",
        VideoJobStatus.Failed => "Failed",
        VideoJobStatus.NoTranscript => "No transcript",
        VideoJobStatus.ProcessedNoIdeas => "Processed · 0 ideas",
        VideoJobStatus.SkippedShort => "Skipped · under 3m",
        _ => status.ToString(),
    };
}
