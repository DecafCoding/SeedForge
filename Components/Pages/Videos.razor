@page "/videos"
@rendermode InteractiveServer
@using SeedForge.Features.Browse
@inject BrowseQueries Browse

<PageTitle>Videos</PageTitle>

<PageHeader Eyebrow="Library" Icon="bi-camera-video" Title="Videos">
    Every discovered/ingested video and its pipeline yield: how many ideas it produced (total / passed
    by each idea's latest score) and how many concepts came out (active / total). Status makes legitimate
    non-yield outcomes — No transcript, Processed · 0 ideas — read clearly. Click a card to open the
    video's details.
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_busy)
{
    <p><em>Loading…</em></p>
}
else if (_rows.Count == 0)
{
    <p><em>No videos yet — enqueue a URL or follow a channel first.</em></p>
}
else
{
    <p class="sf-mono" style="font-size:.72rem;color:var(--sf-faint);">@_rows.Count video@(_rows.Count == 1 ? "" : "s")</p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var r in _rows)
        {
            <div class="col">
                <VideoCard Video="@r" />
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<VideoRow> _rows = Array.Empty<VideoRow>();
    private bool _busy = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = await Browse.VideoRowsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load videos: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
