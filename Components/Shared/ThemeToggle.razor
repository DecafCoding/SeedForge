@using Microsoft.AspNetCore.Http

@* Compact light/dark toggle. This component renders in the static-SSR layout, so it
   holds no per-click state: the inline onclick calls the global seedforgeToggleTheme
   helper from App.razor, which flips the theme based on the live DOM and updates the
   icon. The server only renders the correct initial icon from the theme cookie. *@
<button class="btn btn-sm theme-toggle border-0"
        type="button"
        title="Toggle light / dark theme"
        aria-label="Toggle light / dark theme"
        onclick="seedforgeToggleTheme()">
    <i class="@(_currentTheme == "dark" ? "bi bi-moon-fill" : "bi bi-sun-fill")"></i>
</button>

@code {
    private string _currentTheme = "dark";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext?.Request.Cookies.TryGetValue("seedforge-theme", out var cookieTheme) == true)
        {
            _currentTheme = cookieTheme == "light" ? "light" : "dark";
        }
    }
}

<style>
    .theme-toggle {
        color: inherit;
        line-height: 1;
        padding: 0.25rem 0.5rem;
    }

    .theme-toggle:hover {
        color: inherit;
        background-color: rgba(255, 255, 255, 0.15);
    }

    .theme-toggle i {
        font-size: 1.1rem;
        vertical-align: middle;
    }
</style>
